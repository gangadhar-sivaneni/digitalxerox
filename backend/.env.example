# Digital Xerox backend configuration
PORT=4000
API_PREFIX=/api
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Comma-separated frontend origins allowed to embed document previews via
# iframe (CSP frame-ancestors). Local dev origins (localhost/127.0.0.1) are
# appended automatically when NODE_ENV is not production.
# FRAME_ANCESTORS=https://digitalxerox.onrender.com
NODE_ENV=development

# Razorpay payment gateway
# Get test-mode (demo) keys from https://dashboard.razorpay.com/ (Settings → API Keys).
# Paste the Key ID and Key Secret below, then the backend switches from the
# built-in simulator to the live Razorpay API on the next boot.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Leave empty to let the backend decide:
#   - keys present  → live mode
#   - keys missing  → deterministic in-process simulator (great for dev/tests)
# Force a mode explicitly with 1 (simulator) or 0 (live):
# RAZORPAY_MOCK=1
# Optional: set once and add https://localhost:4000/api/payments/razorpay/webhook
# to Razorpay Dashboard → Settings → Webhooks for server-side capture events.
RAZORPAY_WEBHOOK_SECRET=

