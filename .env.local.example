# Digital Xerox â€” Local Development Environment Overrides
# Copy this file to .env.local in backend/ and customize as needed.
# .env.local is gitignored â€” never commit real secrets.

# ============================================================
# SERVER
# ============================================================
# PORT=4000                    # Backend port (default: 4000)
# API_PREFIX=/api              # API base path (default: /api)

# ============================================================
# AUTHENTICATION
# ============================================================
# JWT_SECRET=                  # OVERREQUIRED: Generate a strong secret for local dev
#                              # Example: openssl rand -base64 32
#                              # Default (dev only): dev-only-secret-change-me
# JWT_EXPIRES_IN=7d            # Token expiry (default: 7d)

# ============================================================
# DATABASE & STORAGE
# ============================================================
# DB_FILE=storage/db.json      # JSON database file (default: storage/db.json)
# DOC_STORAGE=storage/documents # Document upload directory (default: storage/documents)

# ============================================================
# CORS & SECURITY
# ============================================================
# CORS_ORIGIN=http://localhost:5173  # Frontend origin (default: *)

# ============================================================
# SHOP SETTINGS
# ============================================================
# SHOP_CLOSED_MESSAGE="The shop is currently closed."  # Shown when shop closed

# ============================================================
# DEVELOPMENT
# ============================================================
# NODE_ENV=development         # Set to 'production' for prod build testing
# LOG_LEVEL=debug              # Options: debug, info, warn, error (default: info)

